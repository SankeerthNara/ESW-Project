# ==============================================================================
.gradle/
**/build/
**/app/build/
local.properties
*.apk
*.aab
*.ap_

# Native & Vendor libraries (Qualcomm proprietary binaries)
**/app/libs/*.aar
**/app/src/main/jniLibs/
**/app/src/main/assets/*.dlc
!**/app/src/main/assets/PUT_DLC_FILES_HERE.txt

