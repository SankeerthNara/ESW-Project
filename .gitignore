# Neural Network Models & Large Binary Weights (>100MB / GitHub limits)
# ==============================================================================
*.pth
*.pt
*.onnx
*.onnx.data
*.dlc
*.bin
*.raw

# Checkpoint directories
checkpoints/
**/checkpoints/
*.ckpt

# Model conversion intermediate build outputs
build/
output/
model_conversion/build/
model_conversion/output/
qidk-project/model_conversion/build/
qidk-project/model_conversion/output/
**/htp_test/

